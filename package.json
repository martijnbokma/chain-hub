{
  "name": "chain-hub-v2",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:hub": "bun run --filter @chain-hub/server dev",
    "hub": "turbo run build && node packages/cli/dist/index.js hub",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@types/node": "^24.0.13",
    "turbo": "^2.0.12",
    "typescript": "^5.5.4"
  }
}
