{
  "name": "chain-hub",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --ui=stream --filter=@chain-hub/hub-web --filter=@chain-hub/server --filter=@chain-hub/contracts --filter=@chain-hub/domain --filter=@chain-hub/storage",
    "dev:all": "turbo run dev --ui=stream",
    "dev:hub": "turbo run dev --ui=stream --filter=@chain-hub/server --filter=@chain-hub/hub-web",
    "dev:marketing": "turbo run dev --ui=stream --filter=@chain-hub/marketing-site",
    "dev:docs": "turbo run dev --ui=stream --filter=@chain-hub/docs",
    "hub": "turbo run build && node packages/cli/dist/index.js hub",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage --concurrency=1",
    "test:e2e": "turbo run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.6",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "turbo": "^2.11.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  }
}
