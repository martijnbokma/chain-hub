{
  "name": "chain-hub",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "toml": "^5.0.1",
    "zod": "^4.6.7",
    "esbuild": "^0.28.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "bun scripts/dev.ts",
    "dev:hub": "turbo run dev --ui=stream --filter=@chain-hub/hub-web --filter=@chain-hub/server --filter=@chain-hub/contracts --filter=@chain-hub/domain --filter=@chain-hub/storage",
    "dev:marketing": "turbo run dev --ui=stream --filter=@chain-hub/marketing-site",
    "dev:docs": "turbo run dev --ui=stream --filter=@chain-hub/docs",
    "hub": "turbo run build && node packages/cli/dist/index.js hub",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage --concurrency=1",
    "test:e2e": "turbo run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1"
  }
}
