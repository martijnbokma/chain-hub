    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chain-hub/contracts": "0.1.0",
    "@chain-hub/domain": "0.1.0",
    "@chain-hub/server": "0.1.0",
    "@chain-hub/storage": "0.1.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "tsup": "^8.2.4",
    "tsx": "^4.16.2",
    "vitest": "^2.1.9"
  }
}
