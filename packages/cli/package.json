{
  "name": "@chain-hub/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "chain": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
